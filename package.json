{
  "name": "carbon-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w apps/plugin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "lint:obsidian": "node tools/obsidian-lint/run.mjs",
    "format": "biome format --write .",
    "test": "node scripts/check-manifest.mjs && npm run lint:obsidian && vitest run",
    "e2e": "node --test --test-reporter=spec tests/e2e/two-daemons.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
